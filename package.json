{
  "name": "belegio",
  "version": "1.3.0",
  "description": "Automatischer Beleg-Downloader für den Steuerberater",
  "author": "Alexander Hippler <alexander@hippler.one>",
  "main": "dist/src/main/index.js",
  "scripts": {
    "predev": "npx kill-port 5173 || true",
    "dev": "concurrently -k -n RENDERER,MAIN -c cyan,yellow \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "dev:main": "wait-on http://localhost:5173 && tsc -p src/main/tsconfig.json && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build:main": "tsc -p src/main/tsconfig.json",
    "predist": "node scripts/setup-wincosign-cache.js",
    "dist": "npm run build && npx electron-builder",
    "playwright:install": "node node_modules/playwright/cli.js install chromium"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "playwright": "^1.44.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
