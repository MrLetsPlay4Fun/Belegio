{
  "id": "amazon-business",
  "name": "Amazon Business",
  "version": "1.0.0",
  "baseUrl": "https://www.amazon.de",
  "loginUrl": "https://www.amazon.de/gp/sign-in.html",
  "loginCheckUrl": "https://www.amazon.de/gp/your-account/order-history",
  "loginCheck": {
    "type": "element_exists",
    "selector": ".a-box-group, .order-card"
  },
  "authUrlPatterns": ["/ap/", "signin", "sign-in", "openid.mode=checkid_setup"],
  "dateLocale": "de",
  "invoiceSteps": [
    {
      "type": "foreach_years",
      "url_template": "https://www.amazon.de/gp/your-account/order-history?orderFilter=year-{year}",
      "steps": [
        {
          "type": "paginate",
          "next_selector": ".a-last:not(.a-disabled) a",
          "max_pages": 20,
          "steps": [
            {
              "type": "loop_items",
              "item_selector": ".a-box-group:has(a[href*='order-details'])",
              "steps": [
                {
                  "type": "download",
                  "selector": "a:has-text('Rechnung')",
                  "filename_pattern": "AmazonBusiness_{id}",
                  "mode": "fetch",
                  "optional": true
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "outputPath": "Amazon Business/{year}/{month}",
  "downloadExtensions": [".pdf"]
}
